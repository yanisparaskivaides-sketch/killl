# Required: Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Optional: enables AI features through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: restrict bot operations/config to a particular Discord server where supported
DISCORD_GUILD_ID=

# Optional: persistent directories. Use paths supported by your host.
BOT_DATA_DIR=bot/data
BOT_BACKUP_DIR=bot/backups
LOG_LEVEL=INFO
